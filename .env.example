# Modelo do .env — vai para TODO clone. Os segredos ficam VAZIOS de proposito:
# `make bootstrap` copia este arquivo para .env e gera valores fortes
# (APP_SECRET, FERNET_KEY, EXECUTOR_SIGNING_KEY, OTP_PEPPER, AUTH_SECRET,
# REDIS_PASSWORD, MINIO_ROOT_PASSWORD). Nunca commite um valor real aqui.
# Fuso do processo (logs e horas sem fuso). UTC evita a classe de bugs de
# conversão que um fuso local já causou aqui; o fuso dos AGENDAMENTOS é outro,
# abaixo (AGENDAMENTO_FUSO_PADRAO).
TZ=UTC
# Certificado do site (cert.pem e key.pem): o de origem da Cloudflare, um do
# Let's Encrypt ou outro. Em produção, aponte para onde ele está no host.
SSL_CERT_DIR=./certs

# Banco de dados
# O Postgres nao sobe pelo compose: aponte para o seu.
DATABASE_URL="postgresql+asyncpg://<usuario>:<senha>@<host>:5432/<banco>"
# Redis — defina REDIS_PASSWORD com um valor seguro
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=troque-me-bootstrap-gera-um-forte
# REDIS_URL é construído no docker-compose.yml — não definir aqui
# Storage dos contadores de rate limit por IP (app/core/rate_limiter.py).
# Sem definir: o mesmo Redis da aplicação (REDIS_URL), e os limites valem
# para a API inteira; se o Redis cair, o slowapi cai para memória sozinho e
# volta quando ele responder. `memory://` força a memória de cada worker —
# com `--workers 4`, um limite de 10/minute passa a valer até 4x.
#RATE_LIMIT_STORAGE_URI=memory://
# A CA do Postgres, para `?ssl=verify-ca` ou `verify-full` no DATABASE_URL
# (app/core/db.py). No Docker, e o caminho DENTRO do container da API: ponha o
# arquivo num volume montado nele (ou na imagem). Sem o arquivo, so `ssl=require`.
#DATABASE_CA_CERT=/app/certs/postgres-ca.crt

# Roteamento por política de execução (níveis, reserva, último recurso).
# off (padrão) = comportamento legado, editor da política como prévia; on = a política vale.
# Ligue primeiro em staging; reversão = off + recriar o container da API.
EXECUTOR_POLICY_ROUTING=off

# Configurações API. O compose não repassa API_HOST nem ECHO_SQL ao container
# (lá o uvicorn escuta em 0.0.0.0:8000 e o SQL não é ecoado); valem para a API
# rodando fora do Docker. API_PORT é a porta publicada em dev e a que o web
# recebe como NEXT_PUBLIC_API_PORT.
API_HOST=0.0.0.0
API_PORT=8000

# Pool de conexões do PostgreSQL, POR WORKER: o teto da API é workers ×
# (POOL_SIZE + MAX_OVERFLOW), e o max_connections padrão do Postgres é 100. O
# compose não repassa estas variáveis: no container valem os padrões de
# app/core/config.py (8 e 5; com os 4 workers do api-prod, 52 conexões). Aqui
# elas valem para a API rodando fora do Docker.
POOL_SIZE=10
MAX_OVERFLOW=5
POOL_TIMEOUT=30
POOL_RECYCLE=1800
# Prazo de cada comando no banco, em segundos. DB_STATEMENT_TIMEOUT: o
# Postgres cancela o comando (conta a espera por lock). DB_COMMAND_TIMEOUT: o
# asyncpg desiste quando o banco nem responde — maior que o anterior. Vazio =
# 60 e 90; 0 desliga. Antes de baixar, veja a consulta legítima mais lenta
# (docs/operations.md, "Prazo das consultas ao banco").
#DB_STATEMENT_TIMEOUT=60
#DB_COMMAND_TIMEOUT=90
ECHO_SQL=false

# Configurações Token
APP_SECRET=

# Configurações CORS
# Liste as origens permitidas separadas por vírgula.
# Em produção NUNCA use * — especifique o(s) domínio(s) reais.
ALLOWED_ORIGINS=http://localhost

# ── Proxy reverso confiável (Traefik) ──────────────────────────────
# IPs/CIDRs de onde a API aceita headers de proxy. Impacta DUAS coisas:
#   1. X-Forwarded-Tls-Client-Cert-Info — a identidade mTLS dos executores.
#      Requisições vindas de fora desta lista têm o header rejeitado (o
#      Traefik já o remove na borda; esta é a segunda camada).
#   2. X-Forwarded-For — usado como chave de rate limit. Sem isso, todos os
#      limites viram um balde único (o IP do Traefik) para a plataforma toda.
# Vazio: fora do Docker, desliga as duas checagens (só para dev sem proxy na
# frente); no compose, vazio vale 172.16.0.0/12 (a rede do Traefik).
# Em produção use a rede docker do Traefik, ex: 172.16.0.0/12
TRUSTED_PROXIES=

# Proxies de BORDA que ANEXAM o IP do cliente ao X-Forwarded-For (Cloudflare).
# Atrás da Cloudflare o 1º elemento do header é o que o cliente escreveu
# (forjável): a API caminha o header da direita para a esquerda, pula
# TRUSTED_PROXIES e EDGE_PROXIES e usa o primeiro IP que sobra.
# Só afeta o IP usado em rate limit/auditoria — NÃO autoriza o header de
# cert mTLS (isso é só TRUSTED_PROXIES).
# Ausente (padrão) = faixas publicadas da Cloudflare, IPv4 e IPv6
#   (CLOUDFLARE_RANGES em app/core/trusted_proxy.py). Vazio = desligado.
# O compose não a repassa: no container vale sempre o padrão. Fora do Docker,
# sem Cloudflare na frente, descomente e deixe vazio:
#EDGE_PROXIES=

# ── Hosts, imagens e borda (docker-compose.yml + Traefik) ──────────
# Os três hosts que o Traefik roteia (perfil prod). Os padrões *.localhost só
# servem para subir na própria máquina.
PUBLIC_HOST=localhost
AGENTS_HOST=agents.localhost
S3_HOST=s3.localhost
# As imagens da API e do web. Construa as suas com
#   docker build -f Dockerfile.api -t atlans-api:local .
#   docker build -f web/Dockerfile.ui --build-context raiz=. -t atlans-web:local web
# (o contexto `raiz` é a raiz do repositório: de lá vêm a LICENSE e o
# THIRD-PARTY-NOTICES.md que a imagem do web leva) ou aponte para as de um registry.
ATLANS_API_IMAGE=atlans-api:local
ATLANS_WEB_IMAGE=atlans-web:local
# A borda: o middleware na frente dos routers públicos e as faixas de onde o
# Traefik aceita X-Forwarded-*. O nome escolhe também de onde vem o IP do
# cliente nos rate limits (`rate-mcp-<borda>` e `rate-download-<borda>` no
# traefik-dynamic/dynamic.yml): sem CDN, o da conexão; atrás da Cloudflare, o
# que ela anexa ao X-Forwarded-For. Uma borda própria precisa dos dois rate
# limits dela no dynamic.yml. Sem CDN (padrão), o Traefik é a borda:
BORDA_MIDDLEWARE=borda-aberta
BORDA_FAIXAS_CONFIAVEIS=127.0.0.1/32
# Atrás da Cloudflare, só ela fala com o origin:
#BORDA_MIDDLEWARE=cloudflare-only
#BORDA_FAIXAS_CONFIAVEIS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
# A faixa da rede do Traefik (proxy-net), dentro de TRUSTED_PROXIES (padrão
# 172.16.0.0/12): é dela que a API aceita o header do cert dos executores. Se a
# subida falhar com "Pool overlaps with other one on this address space" (outra
# rede do Docker já usa a faixa), escolha uma livre, ex.: 172.29.0.0/16. Só
# vale na criação da rede: para trocar depois, `docker network rm proxy-net`.
#PROXY_NET_SUBNET=172.18.0.0/16
# Versão da API do Docker para o Traefik. Vazio = negocia com o engine (o certo
# para Docker atual); um engine antigo que não negocia pede o valor (ex.: 1.41).
DOCKER_API_VERSION=
# Driver de log da API e do web: json-file roda em qualquer host; num servidor
# com systemd, journald guarda o log no host depois de cada deploy.
LOG_DRIVER=json-file
# Onde o access log do Traefik fica no host.
TRAEFIK_LOG_DIR=./logs/traefik
# O Redis (filas, cache, limites). Padrão: Valkey, de licença livre. Uma
# instalação que já roda o Redis 7.4 fica nele: o Valkey não lê aqueles dados.
REDIS_IMAGE=valkey/valkey:8-alpine

# ── Auth.js (Next.js frontend) ────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# URL pública da aplicação — usada pelo Auth.js para resolver redirects (ex: signOut)
# Em dev local com Traefik: http://localhost
# Em prod com domínio: https://seudominio.com
AUTH_URL=http://localhost

# URL interna do backend — usada pelo Route Handler (/terra/*) e auth.ts em runtime
# Em Docker prod: http://api-prod:8000 | Dev: http://api:8000
# NÃO é necessário expor esta URL ao browser — tudo vai pelo proxy interno.
API_INTERNA=http://api:8000

# ── Criptografia de credenciais ───────────────────────────────────
# A FERNET_KEY criptografa connectionStrings dos nós datasource no banco
FERNET_KEY=
# Rotação (opcional): várias chaves, a primeira cifra e todas decifram:
# FERNET_KEYS="<nova>,<antiga>" (app/core/config.py). A FERNET_KEY continua
# lendo o que já foi cifrado com ela.
#FERNET_KEYS=

# Chave privada Ed25519 do servidor, usada para assinar digitalmente os jobs enviados aos executores via WebSocket.
EXECUTOR_SIGNING_KEY=

# ── mTLS + Bootstrap OTP (enrollment de executores) ────────────────────────
# step-ca interna que emite certs mTLS para executores.
STEPCA_URL=https://step-ca:9000
STEPCA_PROVISIONER_NAME=atlans-app
# Em prod: senha do provisioner JWK; defina apos init do step-ca.
STEPCA_PROVISIONER_PASSWORD=
# Fingerprint SHA-256 do root cert (string hex) para pinning no executor.
STEPCA_ROOT_FINGERPRINT=

# HMAC pepper dos OTPs de enrollment. Gere com:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# CRITICO: rotacionar invalida TODOS os OTPs em voo.
OTP_PEPPER=

# TTLs (defaults razoaveis). O cert de cada executor vale EXECUTOR_CERT_TTL_DAYS
# dias, no maximo 365: e o teto que o scripts/bootstrap-stepca.sh poe na step-ca.
EXECUTOR_CERT_TTL_DAYS=90
EXECUTOR_OTP_TTL_HOURS=24

MINIO_ENDPOINT=http://minio:9000
# Endpoint para pre-signed URLs (acessível pelo browser)
# Dev: localhost:9000 | Produção: domínio público do S3
# EM PRODUÇÃO precisa ser o endereço público do S3 (ex.: https://s3.seu-dominio):
# a assinatura prende o host, e
# com localhost aqui as URLs pré-assinadas do Drive, dos artefatos e do
# servidor MCP só abrem de dentro do Docker — fora dele não resolvem.
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_BUCKET=atlans-drive
# Validade das URLs pré-assinadas, em segundos; sem a variável o compose usa 3600.
MINIO_PRESIGN_EXPIRY=900
# Origens permitidas para as URLs pre-assinadas do S3 (a Home busca o GeoJSON de
# uma camada direto do navegador). `*` mantem o default do MinIO; restrinja em
# producao a origem da app (ex.: https://seu-dominio).
MINIO_API_CORS_ALLOW_ORIGIN=*

# ── Endereços desta instalação ─────────────────────────────────────
# O site, como o navegador o abre: vai nos links dos e-mails, e os padrões
# abaixo partem dele. Em produção, o domínio da instalação (https://seu-dominio).
FRONTEND_URL=http://localhost:3000
# Host dos executores (mTLS), em https. Vazio = https://agents.<host do
# FRONTEND_URL>; sem domínio (localhost, IP), fica vazio e a tela de matrícula
# pede o endereço.
#AGENTS_URL=https://agents.seu-dominio
# Repositório que o install.sh clona na máquina do executor (o quickstart da
# tela de matrícula). Vazio: o script pede --repo=.
#EXECUTOR_REPO_URL=https://github.com/jlanio/atlans-studio.git
# Repositório do GitHub (dono/nome) cujas releases desktop/v* trazem o
# instalador Windows que o painel oferece. Vazio: o painel não oferece o app.
#DESKTOP_RELEASES_REPO=<dono>/<repo>
# Hosts aceitos pelo transporte do servidor MCP (/mcp), separados por vírgula.
# Vazio = o host do FRONTEND_URL (com e sem porta) + localhost:* e 127.0.0.1:*;
# um Host fora da lista recebe 421.
#MCP_ALLOWED_HOSTS=seu-dominio,seu-dominio:*,localhost:*,127.0.0.1:*

# ── E-mail (verificação de conta, senha, alertas e o nó SendEmail) ──
# O transporte: resend, smtp ou log (nada sai; o e-mail vai para o log).
# Vazio = o que estiver configurado abaixo: Resend com a chave, SMTP com o
# host, log sem nenhum dos dois (modo dev). Um valor desconhecido (aqui ou em
# SMTP_SEGURANCA), smtp sem SMTP_HOST, resend sem a chave ou SMTP sem TLS com
# usuário (a senha iria em claro) impedem a API de subir. Em modo log a
# verificação de conta e a redefinição de senha NÃO funcionam: os links com o
# token não vão para o log (só os campos, mascarados; o conteúdo completo com
# LOG_LEVEL=DEBUG, para o desenvolvimento local).
#EMAIL_BACKEND=
# Resend (resend.com). Cada instalação usa a SUA chave.
RESEND_API_KEY=
# Qualquer servidor SMTP. SMTP_SEGURANCA: starttls (padrão, porta 587), ssl
# (TLS desde a conexão, porta 465) ou nenhuma (relay local, porta 25).
# SMTP_PORT vazia = a porta do modo. Sem usuário, não há login.
#SMTP_HOST=smtp.seu-dominio
#SMTP_PORT=587
#SMTP_SEGURANCA=starttls
#SMTP_USERNAME=
#SMTP_PASSWORD=
# O remetente, em qualquer transporte. Vazio = Atlans <noreply@host do
# FRONTEND_URL> (o domínio verificado no provedor). RESEND_FROM_EMAIL, o nome
# antigo, continua valendo.
EMAIL_FROM=
# O login exige o e-mail verificado. Sem transporte, o link de verificação
# nunca chega: false deixa entrar sem ele. O risco: o cadastro é aberto, e
# ninguém confirma que o e-mail é de quem se cadastrou. Alguém pode criar a
# conta com o e-mail de outra pessoa e receber o convite para um workspace
# feito para ela. Com transporte, o convite espera a conta verificar o e-mail;
# sem transporte, confira com a pessoa se a conta é dela antes de convidar.
#EXIGIR_EMAIL_VERIFICADO=true

# ── Assistente (montar fluxos por linguagem natural) ───────────────
# O modelo vem de qualquer API compatível com a da OpenAI: o OpenRouter
# (openrouter.ai, o padrão: uma chave, qualquer modelo do catálogo dele), um
# gateway (LiteLLM) ou um servidor local (Ollama, vLLM, llama.cpp), com um
# modelo que saiba chamar ferramentas. Chave da PLATAFORMA: quem paga os tokens
# do modelo e a instalacao, e o teto por pessoa vive no Redis. SEM a chave o
# assistente simplesmente nao existe — o resto do editor continua inteiro.
# Servidor local sem chave: qualquer valor não vazio (ex.: local).
# OPENROUTER_API_KEY e OPENROUTER_BASE_URL, os nomes antigos, continuam valendo.
LLM_API_KEY=
# A BASE da API, sem /chat/completions (o cliente acrescenta o caminho; se
# vier com ele, nao duplica). Vazio = a do OpenRouter. Ollama local:
# http://ollama:11434/v1
#LLM_BASE_URL=https://openrouter.ai/api/v1
# Atribuição do app no OpenRouter: true manda o nome e o FRONTEND_URL desta
# instalação (cabeçalhos X-Title e HTTP-Referer), que aparecem no ranking
# público de apps dele. Vazio = nada identifica a instalação.
#ASSISTENTE_ATRIBUICAO=false
# Desliga o assistente mesmo havendo chave (false/0/off/no).
#ASSISTENTE_ATIVO=true
# Trocar de modelo e editar aqui e reiniciar — nao exige deploy. O nome e o do
# catalogo do provedor: fornecedor/modelo no OpenRouter
# (https://openrouter.ai/models), qwen3:14b no Ollama.
#ASSISTENTE_MODELO=anthropic/claude-opus-5
# Idioma das respostas do assistente (o valor pode levar acento).
#ASSISTENTE_IDIOMA=português do Brasil
# Quantos tokens do modelo cada pessoa gasta em 24 h (a janela nasce na
# primeira conversa). Precisa ser positivo: outro valor impede a API de subir.
#ASSISTENTE_TETO_DE_TOKENS_POR_DIA=1500000

# ── Extensões e licença ────────────────────────────────────────────
# Uma instalação com extensões (subpastas de app/extensoes e web/extensoes)
# pode desligá-las na API sem apagar a pasta: ATLANS_SEM_EXTENSOES=1 (rotas,
# tarefas e templates somem). Vazio = valem. O web NÃO lê a variável: as
# extensões dele entram no build (web/extensoes/instaladas.ts), então com ela
# ligada a tela continua oferecendo o que a API não serve — para desligar de
# vez, construa o web sem a extensão (scripts/sem_extensoes.sh).
#ATLANS_SEM_EXTENSOES=
# O link para o código-fonte desta instalação, na tela de entrada e no menu da
# conta. A AGPL (seção 13) pede que quem usa uma versão modificada pela rede
# possa obter o código dela: aponte para o seu repositório (o oficial, ou o seu
# fork). Vazio = sem o link.
#CODIGO_FONTE_URL=https://github.com/jlanio/atlans-studio
# O nome que a tela mostra: o wordmark da barra lateral, o cabeçalho da tela
# de entrada e o título da aba. Vazio = Atlans, o nome do projeto. A forma com
# o domínio é a instalação do titular, marca dele; quem distribui uma versão
# modificada ou a oferece como serviço põe aqui o nome dela (TRADEMARKS.md).
#NOME_NA_TELA=

# ── Catálogo de fontes (WFS) — docs/fontes.md ────────────────────
# Pasta com a cópia versionada do Vault de geosserviços (instituições do
# Brasil e de outros países das Américas), importada na subida da API
# (idempotente: pasta igual = zero escritas). Fora do .env = a pasta do
# repositório. VAZIA (FONTES_CATALOGO_DIR=) ou inexistente = não importa; o
# catálogo fica só com o que o assistente registrar. Importado, o servidor
# consulta o GetCapabilities de cada endpoint (abaixo).
#FONTES_CATALOGO_DIR=catalogo/geoservicos
# O catálogo aprende das execuções bem-sucedidas do nó WFS (false/0/off/no
# desliga).
#FONTES_APRENDER_DAS_EXECUCOES=true
# Verificação periódica por endpoint (UM GetCapabilities por URL distinta),
# em segundos. 0 desliga toda sondagem que partiria do servidor sozinho.
#FONTES_VERIFICACAO_INTERVAL=86400
# No EXECUTOR: por quanto tempo o nó WFS reaproveita o GetCapabilities de um
# mesmo endpoint entre execuções e retries (segundos; 0 desliga o cache).
#WFS_CAPABILITIES_TTL_S=3600

# Validade dos tokens de conta, em MINUTOS: o de verificação de e-mail e o de
# redefinição de senha.
EMAIL_VERIFY_TOKEN_TTL=1440
PASSWORD_RESET_TOKEN_TTL=30

# ── Fundos de mapa (o mapa, o globo da Home e o nó Carta) ──────────
# Templates de tiles https com {z}, {x} e {y} (o CSP do web bloqueia http fora
# do desenvolvimento), e o crédito que o provedor exige. Sem
# nenhum, só as ruas do OpenStreetMap (sem satélite, e o portal fica sem o
# alternador). O código não traz servidor de satélite: escolha um provedor e
# siga os termos dele. A API os injeta nos nós Carta, e o web os lê a cada
# pedido; o executor não precisa de configuração.
#MAPA_RUAS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#MAPA_RUAS_CREDITO=© OpenStreetMap contributors
#MAPA_SATELITE_URL=https://tiles.seu-provedor/{z}/{x}/{y}.jpg
#MAPA_SATELITE_CREDITO=© Seu provedor
# Satélite com vias e rótulos (o globo da Home e o fundo "Satélite com
# rótulos" da Carta). Vazio = o satélite, nos dois.
#MAPA_HIBRIDO_URL=
#MAPA_HIBRIDO_CREDITO=

# ── Agendamentos ───────────────────────────────────────────────────
# O fuso que vale quando um agendamento não diz o seu (o nó ScheduleTrigger e
# a API). Vazio = UTC. Defina ANTES de criar agendamentos: trocar depois recria,
# no próximo save, cada agendamento sem fuso explícito (o disparo do dia pode
# ser pulado). Nomes IANA: America/Sao_Paulo, Europe/Lisbon, UTC... Um valor que
# não é fuso impede a API de subir (melhor que agendar no fuso errado).
#AGENDAMENTO_FUSO_PADRAO=UTC
# ── Webhook response ─────────────────────────────────────────────
# Acima deste tamanho (bytes), o body do ResponseNode sobe pro MinIO como
# Artifact (com expires_at segundo a retenção global de artefatos) em vez de
# trafegar pelo WebSocket executor→servidor. Evita HoL blocking no WS. Quem lê
# é o EXECUTOR (flow/nodes/outputs/response_node.py): vale no ambiente dele, e
# não no da API.
WEBHOOK_RESPONSE_INLINE_LIMIT=1048576