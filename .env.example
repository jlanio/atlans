# .env template — it goes into EVERY clone. The secrets are left EMPTY on purpose:
# `make bootstrap` copies this file to .env and generates strong values
# (APP_SECRET, FERNET_KEY, EXECUTOR_SIGNING_KEY, OTP_PEPPER, AUTH_SECRET,
# REDIS_PASSWORD, MINIO_ROOT_PASSWORD). Never commit a real value here.
# Process time zone (logs and times without a zone). UTC avoids the class of
# conversion bugs a local zone has already caused here; the SCHEDULES' time zone
# is a different one, below (AGENDAMENTO_FUSO_PADRAO).
TZ=UTC
# Site certificate (cert.pem and key.pem): the Cloudflare origin one, a
# Let's Encrypt one or another. In production, point to where it lives on the host.
SSL_CERT_DIR=./certs

# Database
# Postgres is not started by the compose file: point to your own.
DATABASE_URL="postgresql+asyncpg://<usuario>:<senha>@<host>:5432/<banco>"
# Redis — set REDIS_PASSWORD to a secure value
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=troque-me-bootstrap-gera-um-forte
# REDIS_URL is built in docker-compose.yml — do not define it here
# Storage for the per-IP rate limit counters (app/core/rate_limiter.py).
# Unset: the application's own Redis (REDIS_URL), and the limits apply to
# the whole API; if Redis goes down, slowapi falls back to memory on its own and
# comes back when it responds. `memory://` forces each worker's memory —
# with `--workers 4`, a limit of 10/minute effectively becomes up to 4x.
#RATE_LIMIT_STORAGE_URI=memory://
# The Postgres CA, for `?ssl=verify-ca` or `verify-full` in DATABASE_URL
# (app/core/db.py). In Docker, it is the path INSIDE the API container: put the
# file in a volume mounted there (or in the image). Without the file, only `ssl=require`.
#DATABASE_CA_CERT=/app/certs/postgres-ca.crt

# Routing by execution policy (tiers, fallback, last resort).
# off (default) = legacy behavior, policy editor as a preview; on = the policy applies.
# Turn it on in staging first; rollback = off + recreate the API container.
EXECUTOR_POLICY_ROUTING=off

# API settings. The compose file does not pass API_HOST or ECHO_SQL to the container
# (there uvicorn listens on 0.0.0.0:8000 and SQL is not echoed); they apply to the API
# running outside Docker. API_PORT is the port published in dev and the one the web
# app receives as NEXT_PUBLIC_API_PORT.
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL connection pool, PER WORKER: the API's ceiling is workers ×
# (POOL_SIZE + MAX_OVERFLOW), and Postgres' default max_connections is 100. The
# compose file does not pass these variables: in the container the defaults from
# app/core/config.py apply (8 and 5; with api-prod's 4 workers, 52 connections). Here
# they apply to the API running outside Docker.
POOL_SIZE=10
MAX_OVERFLOW=5
POOL_TIMEOUT=30
POOL_RECYCLE=1800
# Timeout for each database command, in seconds. DB_STATEMENT_TIMEOUT:
# Postgres cancels the command (waiting for a lock counts). DB_COMMAND_TIMEOUT:
# asyncpg gives up when the database does not respond at all — larger than the
# former. Empty = 60 and 90; 0 disables. Before lowering, check the slowest
# legitimate query (docs/operations.md, "Database query timeouts").
#DB_STATEMENT_TIMEOUT=60
#DB_COMMAND_TIMEOUT=90
ECHO_SQL=false

# Token settings
APP_SECRET=

# CORS settings
# List the allowed origins separated by commas.
# In production NEVER use * — specify the real domain(s).
ALLOWED_ORIGINS=http://localhost

# ── Trusted reverse proxy (Traefik) ────────────────────────────────
# IPs/CIDRs from which the API accepts proxy headers. It affects TWO things:
#   1. X-Forwarded-Tls-Client-Cert-Info — the executors' mTLS identity.
#      Requests coming from outside this list have the header rejected
#      (Traefik already strips it at the edge; this is the second layer).
#   2. X-Forwarded-For — used as the rate limit key. Without it, all
#      limits become a single bucket (Traefik's IP) for the whole platform.
# Empty: outside Docker, disables both checks (only for dev with no proxy in
# front); in the compose file, empty means 172.16.0.0/12 (Traefik's network).
# In production use Traefik's docker network, e.g.: 172.16.0.0/12
TRUSTED_PROXIES=

# EDGE proxies that APPEND the client IP to X-Forwarded-For (Cloudflare).
# Behind Cloudflare, the 1st element of the header is whatever the client wrote
# (forgeable): the API walks the header from right to left, skips
# TRUSTED_PROXIES and EDGE_PROXIES and uses the first IP left over.
# It only affects the IP used for rate limiting/auditing — it does NOT authorize
# the mTLS cert header (that is TRUSTED_PROXIES only).
# Absent (default) = Cloudflare's published ranges, IPv4 and IPv6
#   (CLOUDFLARE_RANGES in app/core/trusted_proxy.py). Empty = disabled.
# The compose file does not pass it: in the container the default always applies.
# Outside Docker, with no Cloudflare in front, uncomment it and leave it empty:
#EDGE_PROXIES=

# ── Hosts, images and edge (docker-compose.yml + Traefik) ──────────
# The three hosts Traefik routes (prod profile). The *.localhost defaults are
# only good for running on your own machine.
PUBLIC_HOST=localhost
AGENTS_HOST=agents.localhost
S3_HOST=s3.localhost
# The API and web images. Build your own with
#   docker build -f Dockerfile.api -t atlans-api:local .
#   docker build -f web/Dockerfile.ui --build-context raiz=. -t atlans-web:local web
# (the `raiz` context is the repository root: the LICENSE and the
# THIRD-PARTY-NOTICES.md that the web image carries come from there) or point to a registry's.
ATLANS_API_IMAGE=atlans-api:local
ATLANS_WEB_IMAGE=atlans-web:local
# The language of make bootstrap and make up-dev / up-prod: pt, en or es. The
# bootstrap asks on the first run and writes it here (with ASSISTENTE_IDIOMA,
# below, in the same language when that one is not set).
#ATLANS_LANG=pt
# The edge: the middleware in front of the public routers and the ranges from
# which Traefik accepts X-Forwarded-*. The name also picks where the client IP
# comes from in the rate limits (`rate-mcp-<borda>` and `rate-download-<borda>` in
# traefik-dynamic/dynamic.yml): without a CDN, the connection's; behind Cloudflare,
# the one it appends to X-Forwarded-For. A custom edge needs its own two rate
# limits in dynamic.yml. Without a CDN (default), Traefik is the edge:
BORDA_MIDDLEWARE=borda-aberta
BORDA_FAIXAS_CONFIAVEIS=127.0.0.1/32
# Behind Cloudflare, only Cloudflare talks to the origin:
#BORDA_MIDDLEWARE=cloudflare-only
#BORDA_FAIXAS_CONFIAVEIS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
# The range of Traefik's network (proxy-net), inside TRUSTED_PROXIES (default
# 172.16.0.0/12): it is from there that the API accepts the executors' cert header.
# `make bootstrap` fills it in: a free /16 inside 172.16.0.0/12 (172.29.0.0/16
# first), or the range of proxy-net when the network already exists. Unset, the
# compose file uses 172.18.0.0/16, the first range Docker hands out to other
# networks, and startup may fail with "Pool overlaps with other one on this
# address space". Changing it makes the next `up` recreate proxy-net in the new range.
#PROXY_NET_SUBNET=172.29.0.0/16
# Docker API version for Traefik. Empty = negotiate with the engine (the right
# choice for current Docker); an old engine that does not negotiate needs the value (e.g.: 1.41).
DOCKER_API_VERSION=
# Log driver for the API and the web app: json-file runs on any host; on a server
# with systemd, journald keeps the log on the host across deploys.
LOG_DRIVER=json-file
# Where Traefik's access log lives on the host.
TRAEFIK_LOG_DIR=./logs/traefik
# Redis (queues, cache, limits). Default: Valkey, freely licensed. An
# installation already running Redis 7.4 stays on it: Valkey cannot read that data.
REDIS_IMAGE=valkey/valkey:8-alpine

# ── Auth.js (Next.js frontend) ────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the application — used by Auth.js to resolve redirects (e.g.: signOut)
# In local dev with Traefik: http://localhost
# In prod with a domain: https://seudominio.com
AUTH_URL=http://localhost

# Internal backend URL — used by the Route Handler (/terra/*) and auth.ts at runtime
# In Docker prod: http://api-prod:8000 | Dev: http://api:8000
# This URL does NOT need to be exposed to the browser — everything goes through the internal proxy.
API_INTERNA=http://api:8000

# ── Credential encryption ─────────────────────────────────────────
# FERNET_KEY encrypts the datasource nodes' connectionStrings in the database
FERNET_KEY=
# Rotation (optional): several keys, the first encrypts and all decrypt:
# FERNET_KEYS="<nova>,<antiga>" (app/core/config.py). FERNET_KEY keeps
# reading what was already encrypted with it.
#FERNET_KEYS=

# The server's Ed25519 private key, used to digitally sign the jobs sent to executors over WebSocket.
EXECUTOR_SIGNING_KEY=

# ── mTLS + Bootstrap OTP (executor enrollment) ─────────────────────────────
# Internal step-ca that issues mTLS certs for executors.
STEPCA_URL=https://step-ca:9000
STEPCA_PROVISIONER_NAME=atlans-app
# In prod: JWK provisioner password; set it after initializing step-ca.
STEPCA_PROVISIONER_PASSWORD=
# SHA-256 fingerprint of the root cert (hex string) for pinning in the executor.
STEPCA_ROOT_FINGERPRINT=

# HMAC pepper for the enrollment OTPs. Generate with:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# CRITICAL: rotating it invalidates ALL in-flight OTPs.
OTP_PEPPER=

# TTLs (reasonable defaults). Each executor's cert is valid for EXECUTOR_CERT_TTL_DAYS
# days, at most 365: that is the ceiling scripts/bootstrap-stepca.sh sets in step-ca.
EXECUTOR_CERT_TTL_DAYS=90
EXECUTOR_OTP_TTL_HOURS=24

# The executor that `make up-dev` brings up on its own (profile executor-local;
# docs/reference.md, "Local executor"). Development only. The executors host
# name in dev, the loopback port where traefik-dev serves it to an executor
# outside Docker on this machine (https://agents.localhost:8443), and the
# executor's memory ceiling.
#EXECUTOR_LOCAL_HOST=agents.localhost
#EXECUTOR_LOCAL_PORT=8443
#EXECUTOR_LOCAL_MEMORY=2G

MINIO_ENDPOINT=http://minio:9000
# Endpoint for pre-signed URLs (reachable by the browser)
# Dev: localhost:9000 | Production: public S3 domain
# IN PRODUCTION it must be the public S3 address (e.g.: https://s3.seu-dominio):
# the signature binds the host, and
# with localhost here the pre-signed URLs of the Drive, of artifacts and of the
# MCP server only open from inside Docker — outside it they do not resolve.
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_BUCKET=atlans-drive
# Validity of the pre-signed URLs, in seconds; without the variable the compose file uses 3600.
MINIO_PRESIGN_EXPIRY=900
# Origins allowed for the S3 pre-signed URLs (Home fetches a layer's GeoJSON
# directly from the browser). `*` keeps MinIO's default; in production restrict
# it to the app's origin (e.g.: https://seu-dominio).
MINIO_API_CORS_ALLOW_ORIGIN=*

# ── Addresses of this installation ─────────────────────────────────
# The site, as the browser opens it: it goes into the links in e-mails, and the
# defaults below derive from it. In production, the installation's domain (https://seu-dominio).
FRONTEND_URL=http://localhost:3000
# Executors' host (mTLS), over https. Empty = https://agents.<host of
# FRONTEND_URL>; with no domain (localhost, IP), it stays empty and the enrollment
# screen asks for the address.
#AGENTS_URL=https://agents.seu-dominio
# Repository that install.sh clones on the executor machine (the enrollment
# screen's quickstart). Empty: the script asks for --repo=.
#EXECUTOR_REPO_URL=https://github.com/jlanio/atlans-studio.git
# GitHub repository (owner/name) whose desktop/v* releases ship the
# Windows installer the dashboard offers. Empty: the dashboard does not offer the app.
#DESKTOP_RELEASES_REPO=<dono>/<repo>
# Hosts accepted by the MCP server transport (/mcp), comma-separated.
# Empty = the FRONTEND_URL host (with and without port) + localhost:* and 127.0.0.1:*;
# a Host outside the list gets 421.
#MCP_ALLOWED_HOSTS=seu-dominio,seu-dominio:*,localhost:*,127.0.0.1:*

# ── E-mail (account verification, password, alerts and the SendEmail node) ──
# The transport: resend, smtp or log (nothing is sent; the e-mail goes to the log).
# Empty = whatever is configured below: Resend with the key, SMTP with the
# host, log with neither (dev mode). An unknown value (here or in
# SMTP_SEGURANCA), smtp without SMTP_HOST, resend without the key, or SMTP without
# TLS with a username (the password would go in clear text) keeps the API from
# starting. In log mode, account verification and password reset do NOT work: the
# links with the token do not go to the log (only the fields, masked; the full
# content with LOG_LEVEL=DEBUG, for local development).
#EMAIL_BACKEND=
# Resend (resend.com). Each installation uses ITS OWN key.
RESEND_API_KEY=
# Any SMTP server. SMTP_SEGURANCA: starttls (default, port 587), ssl
# (TLS from the connection, port 465) or nenhuma (none; local relay, port 25).
# Empty SMTP_PORT = the mode's port. Without a username, there is no login.
#SMTP_HOST=smtp.seu-dominio
#SMTP_PORT=587
#SMTP_SEGURANCA=starttls
#SMTP_USERNAME=
#SMTP_PASSWORD=
# The sender, for any transport. Empty = Atlans <noreply@host of
# FRONTEND_URL> (the domain verified with the provider). RESEND_FROM_EMAIL, the
# old name, still works.
EMAIL_FROM=
# Login requires a verified e-mail. Without a transport, the verification link
# never arrives: false lets people in without it. The risk: sign-up is open, and
# nobody confirms the e-mail belongs to whoever signed up. Someone can create the
# account with another person's e-mail and receive the invitation to a workspace
# meant for them. With a transport, the invitation waits for the account to verify
# the e-mail; without one, check with the person that the account is theirs before inviting.
#EXIGIR_EMAIL_VERIFICADO=true

# ── Assistant (building workflows from natural language) ───────────
# The model comes from any OpenAI-compatible API: OpenRouter
# (openrouter.ai, the default: one key, any model in its catalog), a
# gateway (LiteLLM) or a local server (Ollama, vLLM, llama.cpp), with a
# model that can call tools. PLATFORM key: whoever pays for the model's tokens
# is the installation, and the per-person ceiling lives in Redis. WITHOUT the key the
# assistant simply does not exist — the rest of the editor stays intact.
# Local server without a key: any non-empty value (e.g.: local).
# OPENROUTER_API_KEY and OPENROUTER_BASE_URL, the old names, still work.
LLM_API_KEY=
# The API BASE, without /chat/completions (the client appends the path; if it
# comes with it, it is not duplicated). Empty = OpenRouter's. Local Ollama:
# http://ollama:11434/v1
#LLM_BASE_URL=https://openrouter.ai/api/v1
# App attribution on OpenRouter: true sends this installation's name and
# FRONTEND_URL (X-Title and HTTP-Referer headers), which appear in its public
# app ranking. Empty = nothing identifies the installation.
#ASSISTENTE_ATRIBUICAO=false
# Turns the assistant off even when there is a key (false/0/off/no).
#ASSISTENTE_ATIVO=true
# Switching models means editing here and restarting — no deploy needed. The name is
# the one in the provider's catalog: vendor/model on OpenRouter
# (https://openrouter.ai/models), qwen3:14b on Ollama.
#ASSISTENTE_MODELO=anthropic/claude-opus-5
# Language of the assistant's replies (the value may contain accents).
#ASSISTENTE_IDIOMA=português do Brasil
# How many model tokens each person spends in 24 h (the window starts at the
# first conversation). Must be positive: any other value keeps the API from starting.
#ASSISTENTE_TETO_DE_TOKENS_POR_DIA=1500000

# ── Extensions and license ─────────────────────────────────────────
# An installation with extensions (subfolders of app/extensoes and web/extensoes)
# can turn them off in the API without deleting the folder: ATLANS_SEM_EXTENSOES=1 (routes,
# tasks and templates disappear). Empty = they apply. The web app does NOT read the
# variable: its extensions go into the build (web/extensoes/instaladas.ts), so with it
# on the screen keeps offering what the API does not serve — to turn them off for
# good, build the web app without the extension (scripts/sem_extensoes.sh).
#ATLANS_SEM_EXTENSOES=
# The link to this installation's source code, on the sign-in screen and in the
# account menu. The AGPL (section 13) requires that whoever uses a modified version
# over a network can obtain its code: point to your repository (the official one, or
# your fork). Empty = no link.
#CODIGO_FONTE_URL=https://github.com/jlanio/atlans-studio
# The name the screen shows: the sidebar wordmark, the sign-in screen header
# and the tab title. Empty = Atlans, the project's name. The form with the
# domain is the holder's installation, their trademark; whoever distributes a
# modified version or offers it as a service puts its own name here (TRADEMARKS.md).
#NOME_NA_TELA=

# ── Source catalog (WFS) — docs/sources.md ─────────────────────────
# Folder with the versioned copy of the geoservice Vault (institutions in
# Brazil and other countries of the Americas), imported at API startup
# (idempotent: same folder = zero writes). Absent from .env = the repository
# folder. EMPTY (FONTES_CATALOGO_DIR=) or nonexistent = no import; the
# catalog only holds what the assistant registers. Once imported, the server
# queries each endpoint's GetCapabilities (below).
#FONTES_CATALOGO_DIR=catalogo/geoservicos
# The catalog learns from successful runs of the WFS node (false/0/off/no
# disables it).
#FONTES_APRENDER_DAS_EXECUCOES=true
# Periodic check per endpoint (ONE GetCapabilities per distinct URL),
# in seconds. 0 disables every probe the server would start on its own.
#FONTES_VERIFICACAO_INTERVAL=86400
# On the EXECUTOR: how long the WFS node reuses the GetCapabilities of the
# same endpoint across runs and retries (seconds; 0 disables the cache).
#WFS_CAPABILITIES_TTL_S=3600

# Validity of the account tokens, in MINUTES: the e-mail verification one and the
# password reset one.
EMAIL_VERIFY_TOKEN_TTL=1440
PASSWORD_RESET_TOKEN_TTL=30

# ── Basemaps (the map, the Home globe and the Carta node) ──────────
# https tile templates with {z}, {x} and {y} (the web CSP blocks http outside
# development), and the attribution the provider requires. With
# none, only OpenStreetMap streets (no satellite, and the portal has no
# switcher). The code ships no satellite server: pick a provider and
# follow its terms. The API injects them into Carta nodes, and the web app reads
# them on each request; the executor needs no configuration.
#MAPA_RUAS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#MAPA_RUAS_CREDITO=© OpenStreetMap contributors
#MAPA_SATELITE_URL=https://tiles.seu-provedor/{z}/{x}/{y}.jpg
#MAPA_SATELITE_CREDITO=© Seu provedor
# Satellite with roads and labels (the Home globe and Carta's "Satélite com
# rótulos" basemap). Empty = plain satellite, in both.
#MAPA_HIBRIDO_URL=
#MAPA_HIBRIDO_CREDITO=

# ── Schedules ──────────────────────────────────────────────────────
# The time zone that applies when a schedule does not state its own (the
# ScheduleTrigger node and the API). Empty = UTC. Set it BEFORE creating schedules:
# changing it later recreates, on the next save, every schedule without an explicit
# zone (that day's trigger may be skipped). IANA names: America/Sao_Paulo,
# Europe/Lisbon, UTC... A value that is not a time zone keeps the API from starting
# (better than scheduling in the wrong zone).
#AGENDAMENTO_FUSO_PADRAO=UTC
# ── Webhook response ─────────────────────────────────────────────
# Above this size (bytes), the ResponseNode body is uploaded to MinIO as an
# Artifact (with expires_at according to the global artifact retention) instead of
# traveling over the executor→server WebSocket. Avoids HoL blocking on the WS. The
# reader is the EXECUTOR (flow/nodes/outputs/response_node.py): it applies in its
# environment, not in the API's.
WEBHOOK_RESPONSE_INLINE_LIMIT=1048576