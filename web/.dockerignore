# The build context is `web/`, so the root .dockerignore does NOT apply here.
# Without this file, a local build sent node_modules (1.1 GB) and .next
# (1.4 GB) to the daemon before the first layer started.
node_modules
.next
coverage
.git
# Generated at build time (npm run build → scripts/copiar-monaco.mjs and
# copiar-maplibre.mjs). A stale copy from local dev does not get into the context; the
# builder stage copies the one from the installed version.
public/monaco
public/maplibre
