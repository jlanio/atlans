# ---------- Base ----------
FROM node:24-alpine AS base
WORKDIR /app
# NEXT_TELEMETRY_DISABLED: `next build` and `next dev` send usage telemetry
# to Vercel by default; no build of this repository sends it.
ENV CI=true \
    NPM_CONFIG_LOGLEVEL=info \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_PROGRESS=false \
    NEXT_TELEMETRY_DISABLED=1
# If native libs are needed: uncomment
# RUN apk add --no-cache libc6-compat python3 make g++

# ---------- DEV (hot-reload) ----------
FROM base AS dev
# The .npmrc goes along: it is what turns off the packages' install scripts
# (ignore-scripts) — without it here, the image build would run them.
COPY package*.json .npmrc ./
# npm install (instead of npm ci) to accept new packages without regenerating the lockfile on the host
RUN echo ">> npm install (dev)..." && npm install
COPY . .
EXPOSE 3000
CMD ["npm", "run", "dev"]

# ---------- DEPS for build ----------
FROM base AS deps
COPY package*.json .npmrc ./
RUN echo ">> npm ci (deps)..." && npm ci

# ---------- BUILD (production) ----------
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# `public/` is optional for Next, but the runner stage copies the whole
# directory: this makes sure it exists even with no static file in the repo.
RUN mkdir -p public
RUN echo ">> npm run build..." && npm run build

# ---------- RUNNER (production) ----------
# `output: "standalone"` (next.config.ts) makes the build generate `.next/standalone`:
# `server.js` and ONLY the modules it imports, resolved by file tracing.
# That is what goes into the image — and nothing else.
#
# The previous version copied the ENTIRE `.next`, and `.next/cache` (the
# webpack cache, ~1.4 GB) went to production along with it without ever being read. Then it ran
# a second `npm ci --omit=dev`, which, coming AFTER the COPY of `.next`, never
# hit the layer cache. The image tarball was 731 MB; the two images
# on the server added up to 7.5 GB.
FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
# The Atlans license and the third-party notices go with the image (the AGPL requires the
# license alongside every copy). They come from the named context `raiz` (the
# repository root): `additional_contexts` in compose, `build-contexts: raiz=.` in
# docker/build-push-action, `--build-context raiz=.` in a `docker build` run
# at the repository root (the command is in .env.example).
COPY --from=raiz LICENSE THIRD-PARTY-NOTICES.md ./
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
