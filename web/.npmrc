# No package runs code at install time (preinstall/install/postinstall).
#
# That is the door the 2025 npm worms used (Shai-Hulud and co.): the malicious version
# of a package stole tokens (npm, GitHub, cloud) from the machine or the runner during
# `npm install` and republished itself. With this, installing runs nothing — not in
# CI, not in the image build, not on a developer's machine.
#
# The packages here with an install script do not need it:
#   - esbuild, @tailwindcss/oxide and unrs-resolver: the script is a plan B to
#     download the native binary, which already arrives via the optional dependencies;
#   - sharp: the script only compiles from source (with a global libvips or
#     --build-from-source); the prebuilt binary comes from the optional dependencies
#     @img/sharp-*;
#   - fsevents (macOS only): the script is a `node-gyp rebuild`, but the
#     compiled binary already ships inside the package.
# Verified: lint, typecheck, tests and build pass without the scripts.
#
# Side effect: npm also stops running the pre/post hooks of
# `npm run` (predev, prebuild...). That is why `dev` and `build` call
# copiar-monaco.mjs explicitly, instead of through a hook.
ignore-scripts=true
