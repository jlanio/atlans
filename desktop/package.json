{
  "name": "atlans-executor-desktop",
  "productName": "Atlans Executor",
  "version": "2.15.0",
  "description": "App desktop do executor Atlans — empacota o executor Python e seu runtime para Windows",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "author": "Atlans",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "python:fetch": "node scripts/fetch-python.mjs",
    "python:lock:check": "node scripts/check-lock.mjs",
    "python:build": "node scripts/build-python-runtime.mjs",
    "python:smoke": "node scripts/smoke-python.mjs",
    "smoke:supervisor": "node scripts/smoke-supervisor.mjs",
    "payload:stage": "node scripts/payload-stage.mjs",
    "runtime": "npm run python:fetch && npm run python:build && npm run payload:stage && npm run python:smoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer && npm run payload:stage",
    "dev": "node scripts/dev.mjs",
    "dist": "npm run build && npm run empacotar",
    "empacotar": "electron-builder --win --x64",
    "sign:selftest": "node scripts/sign-selftest.mjs",
    "electron:binario": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0"
  }
}
