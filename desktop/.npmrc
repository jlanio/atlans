# No package runs code at install time (preinstall/install/postinstall).
#
# It is the door of the 2025 npm worms (Shai-Hulud and co.): the malicious
# version of a package stole tokens (npm, GitHub, cloud) from the machine or
# runner during `npm install` and republished itself. With this, installing
# executes nothing — not in CI, not in the release workflow (where the signing
# secrets are), not on the developer's machine.
#
# esbuild (vite, vitest) only uses the script as a plan B: the binary comes
# through the optional dependency. electron, since 44, has no install script:
# it downloads its own binary the first time it is called (checking the
# SHA-256 against the package's checksums.json) — `npm run dev` does this in a
# visible step, and `npm run electron:binario` does it by hand. Packaging
# (electron-builder) downloads Electron on its own, and the tests use the
# mocked module.
#
# Side effect: npm also stops running the pre/post hooks of `npm run`. This
# package.json uses none.
ignore-scripts=true
