# Python runtime, payload and installers — all GENERATED by the build scripts.
# Nothing in resources/ should be versioned: it is ~370 MB rebuildable from
# python-runtime.json + the executor lock (executor/requirements-full.txt).
resources/
dist/
# `dist/` does NOT cover this one: they are directories with different names,
# and the pattern needs to be explicit. Without it, `git add -A` would pull
# ~890 MB into the history — the NSIS installer plus Electron's `win-unpacked`
# tree.
dist-installer/
node_modules/
