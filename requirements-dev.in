# requirements-dev.in — development tools that don't go into the
# API image (Dockerfile.api installs only requirements.txt). Edit HERE;
# requirements-dev.txt is generated from it, with hashes (python scripts/travar_python.py).
#   pip install --require-hashes -r requirements.txt -r requirements-dev.txt
#   ruff check .
# CI (the "Backend (Python)" job) installs both locks: the local version and the CI's
# are the same, and a new ruff rule only arrives together with a change to this pin.
#
# What the tools share with the API (rich, requests, packaging...) comes out
# at the SAME version as the API lock: the script compiles this file with
# `--constraint requirements.txt`. Without it, installing both in the same
# environment would swap API packages out from under the tests. The constraint goes
# on the command line, not in a `-c` here, because of Dependabot (see PARES in
# scripts/travar_python.py).

ruff==0.16.8

# Audit of known vulnerabilities (the CI's "Auditoria de dependências" job,
# which for now only reports). Locally, the same command as CI — the locks already
# carry everything with hashes, so nothing is resolved or installed:
#   pip-audit -r requirements.txt --disable-pip
#   pip-audit -r executor/requirements-full.txt --disable-pip
pip-audit==2.10.1

# Secret scanning (the CI's "Secrets scan" job and the pre-commit hook). Before,
# CI installed it straight from PyPI, without a hash.
detect-secrets==1.5.0

# pre-commit hooks (.pre-commit-config.yaml): all `repo: local` with
# `language: system`, running these pinned versions. A remote repository hook
# would resolve its own dependencies on PyPI, without hashes, on every
# installation.
pre-commit==4.6.2
pre-commit-hooks==6.0.0

# Only Windows uses it (`build`, from pip-tools, asks for colorama there), and the
# lock is produced on Linux, which doesn't see it. Without it here, whoever commits
# from Windows can't install this lock: --require-hashes rejects a dependency that
# isn't in the file.
colorama==0.4.6

# Lock generation (scripts/travar_python.py): pip-compile produces the format
# Dependabot knows how to update; uv resolves with a cutoff date for the
# 14-day quarantine (pip-compile doesn't filter by date).
pip-tools==7.6.1
uv==0.12.17
