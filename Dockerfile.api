# ── Stage 1: builder — installs build dependencies ───────────────────────────
# Pins Debian bookworm (OpenSSL 3.0, libffi 8) — required by cryptography>=42
# (cryptography 46.0.5 in requirements.in). It used to be `python:3.10-slim` with no
# Debian tag, which could route to bullseye and break the build in the future.
#
# Python 3.12: 3.10 goes out of support in Oct 2026. The same version as
# Dockerfile.executor, the CI's setup-python, the desktop app runtime
# (desktop/python-runtime.json) and .python-version (Dependabot uses it to
# resolve dependencies) — bumping it here requires bumping it in all of them.
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

# requirements.txt is the LOCK (generated from requirements.in by
# scripts/travar_python.py): every dependency, direct and transitive, with
# each file's hash. `--require-hashes`: a file different from the reviewed one —
# swapped on PyPI or in transit — does not install, and nothing enters the build
# without going through a PR. `--only-binary=:all:`: no setup.py runs here
# (building an sdist executes package code); all 117 have wheels for bookworm.
COPY requirements.txt ./
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: --prefix=/install -r requirements.txt

# ── Stage 2: runtime — imagem limpa sem compiladores ─────────────────────────
FROM python:3.12-slim-bookworm

WORKDIR /app

# Runtime libs only (libpq5 for psycopg2, no gcc/headers)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 appuser

# Copia pacotes Python compilados do builder
COPY --from=builder /install /usr/local

# Copy the application code
COPY app ./app
COPY flow ./flow

# Alembic migrations — available in the container to run manually:
#   docker compose exec api-prod alembic upgrade head
# The automatic ENTRYPOINT was removed in 2026-05 — there is a cycle in the revisions
# that must be resolved before re-enabling it (see docs/operations.md).
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

# The body of the base-zero migration (20260924_0001) is READ AT RUNTIME from
# scripts/init_schema.sql (`_RAIZ / "scripts" / "init_schema.sql"`). Without this
# copy, any `alembic upgrade head` in the image — a new database, or a deploy
# that applies migrations on its own to an empty database — dies with FileNotFoundError
# before creating the schema; in a stamped production database nobody notices because
# the upgrade never runs. Only the .sql: the rest of scripts/ is operator tooling
# (step-ca, bootstrap, smoke) and does not belong in the image.
COPY scripts/init_schema.sql ./scripts/init_schema.sql

# Scripts publicos servidos via endpoints (ex.: static/install.sh em /executores/install)
COPY static ./static

# Source catalog (the versioned copy of the geoservice Vault). The API
# imports it at startup (FONTES_CATALOGO_DIR, see docs/sources.md); without this copy
# the import does not run in production and the assistant has no catalog.
COPY catalogo ./catalogo

# The Atlans license and the third-party notices go with the image: whoever
# distributes it distributes what is inside it along with it.
COPY LICENSE THIRD-PARTY-NOTICES.md ./

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--ws", "websockets", "--ws-max-size", "16777216"]
