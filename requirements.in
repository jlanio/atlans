geopandas==1.1.4
# numpy, pandas and pyproj come in through geopandas. Pinned on the switch to Python
# 3.12: on 3.10 the resolver stopped at numpy 2.2.x, pandas 2.3.x and pyproj 3.7.x,
# because the following lines require 3.11+. Unpinned, 3.12 would bring numpy 2.5 and
# pyproj 3.8 here, and pandas 3.0 in both locks
# — a major version, with copy-on-write and the new string dtype silently changing
# the nodes' behavior. Bumping each one is its own PR, with the suite
# green. Same versions in executor/requirements-full.in.
numpy==2.5.3
pandas==2.3.3
pyproj==3.8.0
# Used by flow/executor/spill.py, pin.py and by the GeoParquet nodes (pandas'
