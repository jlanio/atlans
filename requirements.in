# numpy, pandas e pyproj chegam pelo geopandas. Pinados na troca para o Python
# 3.12: no 3.10 o resolvedor parava em numpy 2.2.x, pandas 2.3.x e pyproj 3.7.x,
# porque as linhas seguintes exigem 3.11+. Soltos, o 3.12 traria numpy 2.5 e
# pyproj 3.8 aqui, e pandas 3.0 nos dois locks
# — versao maior, com copy-on-write e o dtype de string novo mudando o
# comportamento dos nos em silencio. Subir cada um e PR proprio, com a suite
# verde. Mesmas versoes em executor/requirements-full.in.
numpy==2.5.3
pandas==2.3.3
pyproj==3.8.0
