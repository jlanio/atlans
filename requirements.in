# Auth JWT
PyJWT==2.14.0
# Password hashing calls bcrypt directly (app/core/utils/jwt_utils.py, in the
# bcrypt_sha256 scheme passlib used to define). The pre-key is 44 bytes, so
# bcrypt versions 4 and 5 (which reject passwords over 72 bytes) work; the
# tests/unit/test_hash_de_senha.py checks the real hash on each version.
bcrypt==5.0.0
