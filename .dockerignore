# Dependencies
node_modules
.venv
__pycache__
*.pyc
**/__pycache__
**/*.pyc

# Logs e debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Builds locais
.next
dist/
build/

# Local settings — in any folder: `COPY executor/` used to carry the building
# machine's executor/.env into the image, readable by everyone.
.env
**/.env
.env.local
agent/.env
agent/agent_key.pem
agent-config/
.vscode/
.idea/

# Docker e Git
.dockerignore
Dockerfile*
.git
# ...except what says which commit is being built (executor/versao.py): the
# current ref, with no objects or config.
!.git/HEAD
!.git/packed-refs
!.git/refs

# Dados locais e dev
*.db
tests/
notebooks/

# Monorepos (caso use)
.cache/
turbo/
pnpm-lock.yaml
