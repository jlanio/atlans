# Local SSL certificates (self-signed for dev — on the VPS use /etc/ssl/cloudflare)
certs/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
# `build/` above comes from the Python packaging template and matches ANY
# directory with that name, at any depth. `desktop/build/` is not build
# output: it holds SOURCE — the icons (.ico/.png), the installer header
# and the signing hook, all referenced by electron-builder.yml and by
# main/ui/tray.ts. Without this exception they do not go into the repo, and the CI
# build breaks on the hook while the packaged app has no tray icon.
!desktop/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

