# Local artifacts gerados por chamadas webhooks
artifacts/
# Exception: Next.js route of the artifacts page and related components
!web/app/(dashboard)/artifacts/
!web/app/components/artifacts/
*.pem
tmp/*

# What the scripts create inside the clone, with secrets inside: the step-ca
# provisioner password (scripts/bootstrap.sh), the TLS certificate and key of the
# executors' host (scripts/bootstrap-stepca.sh), the backups of the CA volume,
# which carry its private key (scripts/backup-stepca.sh), and the CA that
# static/install.sh downloads into the executor's clone. The `*.pem` above covers none:
# they are .txt, .crt/.key and .tar.gz.
secrets/
traefik/atlans-ca/
backups/
executor-certs/

# Monaco served from our own origin: generated by web/scripts/copiar-monaco.mjs
# (prebuild/predev) from node_modules/monaco-editor.
web/public/monaco/
# The MapLibre worker, likewise: generated by web/scripts/copiar-maplibre.mjs from
# node_modules/maplibre-gl.
web/public/maplibre/
