# Dockerfile.executor
# Docker image of the Atlans executor for corporate distribution.
#
# Build (the checkout's commit goes into the version the dashboard shows automatically):
#   docker build -f Dockerfile.executor -t atlans-executor:latest .
#
# Usage — enrollment (first time, OTP + mTLS): see executor/README.md
#   (onboarding is `python -m executor enroll`)
#
# Usage — start the executor:
#   docker compose -f docker-compose.executor.yml up -d

# Pins Debian bookworm (OpenSSL 3.0, libffi 8) — aligned with Dockerfile.api.
# Required for cryptography>=42 (transitive requirement via flow/).
# Python 3.12, the same as the API, CI and the desktop app runtime.
FROM python:3.12-slim-bookworm

WORKDIR /app

# PERF: one thread per native library. numpy/OpenBLAS/GDAL open, by default,
# as many threads as there are cores — and the executor already runs up to
# EXECUTOR_MAX_CONCURRENT simultaneous jobs (default 4, see executor/config.py).
# Without this ceiling there are 4 x N threads competing for N cores: under numeric
# load the context switching usually costs more than the parallelism yields, making
# the whole thing SLOWER than single-threaded.
#
# Parallelism still exists, but in a single place: the job semaphore, which is
# where it is configurable and observable. For machines dedicated to a few large
# jobs, it is worth measuring with a lower EXECUTOR_MAX_CONCURRENT and higher values here.
ENV OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    GDAL_NUM_THREADS=1

# Create non-root user
RUN useradd -m -u 1000 appuser

# Install Python dependencies first (takes advantage of the Docker cache).
# requirements-full.txt is the executor's LOCK (generated from requirements-full.in
# by scripts/travar_python.py), with each file's hash: `--require-hashes`
# rejects a file different from the reviewed one, and nothing enters without going through a PR.
# `--only-binary=:all:`: no setup.py runs in the build — all 65 have wheels for
# bookworm, with GDAL, GEOS and PROJ bundled (pyogrio, shapely, pyproj). That is
# why nothing comes from apt: the -dev packages, gdal-bin and build-essential that
# used to be here were not used (no extension loads them, and no code
# calls ogr2ogr), and Debian's libgdal brought GPL libraries into an image
# that is distributed as a release asset.
COPY executor/requirements-full.txt ./requirements-full.txt
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-full.txt

# Copy the workflow engine and the executor code
COPY flow/ ./flow/
COPY executor/ ./executor/

# The Atlans license and the third-party notices go with the image, which is
# distributed as a release asset.
COPY LICENSE THIRD-PARTY-NOTICES.md ./

# Version the dashboard shows (executor/versao.py): the product's — the same as the
# desktop app — plus the commit, read from the checkout itself: .dockerignore lets
# in only .git/HEAD, packed-refs and refs (no objects or config), and the
# wildcards let the COPY pass even without .git (a build from a tarball: only the
# product version comes out). EXECUTOR_COMMIT and EXECUTOR_BASE, if given, take
# precedence — the release passes the tag's. Written outside the code tree, it beats the
# EXECUTOR_VERSION=1.0.0 that old installations have in .env.
COPY desktop/package.json .gi[t]/HEA[D] .gi[t]/packed-ref[s] .gi[t]/ref[s] /tmp/versao/
ARG EXECUTOR_COMMIT=
ARG EXECUTOR_BASE=
RUN python -m executor.versao /tmp/versao /usr/local/share/atlans-executor/VERSAO \
    && rm -rf /tmp/versao

RUN mkdir -p /data && chown -R appuser:appuser /app /data
USER appuser

ENV PYTHONUNBUFFERED=1 \
    LOG_COLOR=auto \
    LOG_LEVEL=INFO

CMD ["python", "-m", "executor.main"]
