# executor/requirements-full.in
# Complete DIRECT dependencies of the Atlas executor + flow engine. Edit HERE.
#
# This produces executor/requirements-full.txt, the lock with each file's hash
# (python scripts/travar_python.py). It is installed with --require-hashes by
# Dockerfile.executor (and by the quickstart, which builds it) and by the
# desktop app's embedded runtime, on Windows — the CI Desktop job checks that
# it installs there.
#
# Does NOT include dependencies exclusive to the API server:
#   uvicorn, fastapi, pydantic, alembic, PyJWT, slowapi,
#   apscheduler, pytest, aiosqlite.
#
# Style: == (exact), same as the root requirements.in and for the same reasons.
# Before, the pins here were loose (>=), and the divergence was real: it
# resolved geopandas 1.1.4 while the root pins 1.1.3 — the Docker executor and
# the desktop one would run different libraries. When you change a version
# here, also change it in requirements.in and regenerate the locks
# (python scripts/travar_python.py).

# ── Comunicacao ──────────────────────────────────────────────────────────────
websockets==17.1
httpx==0.28.1

# ── Criptografia ─────────────────────────────────────────────────────────────
cryptography==50.0.1

# ── Configuracao ─────────────────────────────────────────────────────────────
python-dotenv==1.2.3

# ── GIS — spatial/ nodes ─────────────────────────────────────────────────────
# geopandas 1.x uses pyogrio as the vector I/O engine (read_file/to_file),
# including Shapefile. `fiona` was removed: it was a second copy of GDAL in the
# bundle and there wasn't a single `import fiona` in the code.
geopandas==1.1.4
shapely==2.1.2
pyproj==3.8.0
pyogrio==0.13.0
# numpy and pandas come in through geopandas. Pinned during the switch to
# Python 3.12: on 3.10 the resolver stopped at numpy 2.2.x and pandas 2.3.x,
# because the following lines require 3.11+. Left loose, 3.12 would bring numpy
# 2.5 and pandas 3.0 — a major version, with copy-on-write and the new string
# dtype silently changing the nodes' behavior. Bumping each one is its own PR,
# with the suite green. Same versions in requirements.in.
numpy==2.5.3
pandas==2.3.3
# Used by flow/executor/spill.py, pin.py and the GeoParquet nodes. Same
# version in requirements.in.
pyarrow==25.0.1

# ── Image map — flow/nodes/outputs/carta_imagem.py ───────────────────────────
# Renders the image map (PNG/JPG/PDF) on the executor. Agg and PDF backends are
# built in and the DejaVu font ships in the package itself: no system
# cairo/freetype in Dockerfile.executor. The 3.10.x line was the last that ran
# on Python 3.10 (the runtime until the switch to 3.12); moving to a new line is
# its own PR. Brings pillow, contourpy, cycler, fonttools, kiwisolver and
# pyparsing (see the desktop lock). Same version in requirements.in.
matplotlib==3.11.2

# ── Dados geoespaciais externos ──────────────────────────────────────────────
OWSLib==0.36.0
geopy==2.5.0

# ── Database — database_query / save_to_postgis nodes ────────────────────────
asyncpg==0.31.0
sqlalchemy==2.0.54
geoalchemy2==0.20.0
psycopg2-binary==2.9.13

# ── Templates e expressoes — Jinja2Branch, ExpressionService ─────────────────
Jinja2==3.1.6
jsonschema==4.26.0
croniter==6.2.4
python-dateutil==2.9.0.post0

# ── Storage MinIO/S3 — upload de artefatos ───────────────────────────────────
boto3==1.43.98

# ── GeoSync — monitoramento e filtragem de arquivos ──────────────────────────
watchdog==6.0.0
pathspec==1.1.1

# ── Cache e utilidades ───────────────────────────────────────────────────────
cachetools==7.2.0
psutil==7.2.2
redis==8.1.0

# ── Live dashboard in the terminal ───────────────────────────────────────────
rich==15.0.0
