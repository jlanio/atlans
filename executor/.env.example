# ===============================================
#  Atlans — configuração do executor
# ===============================================
#
# Apos a matricula (`python -m executor enroll` — ver executor/README.md),
# o executor recebe um cert mTLS persistido em EXECUTOR_CERT_DIR. A partir dai,
# toda autenticacao com o servidor passa por mTLS — sem API key.

# ── Identidade ───────────────────────────────────
# id_hash do executor, recebido do admin ao criar o executor na plataforma.
EXECUTOR_ID=
# Host dos executores da sua instalacao (mTLS de ponta a ponta), em wss://.
# Sem padrao: o enroll grava aqui o --server do comando de matricula.
EXECUTOR_SERVER_URL=

# ── Cert mTLS (persistido no enrollment) ─────────
# Diretorio com cert.pem, chain.pem, ca.pem, key.pem e x25519_key.pem
# (permissoes 0o600 nos arquivos, 0o700 no diretorio).
EXECUTOR_CERT_DIR=./certs

# ── Chave publica do servidor (Ed25519) ──────────
# Obtida em GET /executores/server-public-key. Vazio = auto-fetch no startup.
SERVER_SIGNING_PUBLIC_KEY=

# ── Execucao ─────────────────────────────────────
# EXECUTOR_VERSION nao entra aqui: a imagem Docker grava a versao no build
# (executor/versao.py) e o app desktop define a dele.
# Os padroes de executor/config.py (faixas no executor/README.md) — a tela de
# Ajustes do app desktop marca como "alterado" o que difere deles.
EXECUTOR_MAX_CONCURRENT=4
EXECUTOR_MAX_QUEUE_SIZE=50
EXECUTOR_JOB_TIMEOUT=3600
# Cap do backoff exponencial entre tentativas de reconexao no WebSocket (s).
# EXECUTOR_RECONNECT_MAX_DELAY=15

# Auto-restart quando o servidor manda `config_changed` (ex: um workspace
# atribuiu este executor). O executor precisa reler a configuracao no boot.
#   auto (default) — re-executa o proprio processo quando NAO ha supervisor;
#                    em container, sai com codigo 1 e deixa o Docker reiniciar
#                    (`restart: on-failure`), o que tambem pega imagem nova.
#   always         — sempre re-executa, mesmo em container.
#   never          — apenas encerra; use se um supervisor externo (systemd,
#                    pm2, NSSM) ja cuida do restart.
# Guarda anti-loop: no maximo 5 reinicios em 5 minutos.
# EXECUTOR_AUTO_RESTART=auto

# ── Seguranca ────────────────────────────────────
# TTL do cache de nonces para anti-replay de jobs (s). Default 600.
# NONCE_CACHE_TTL=600

# ── Logs e painel ────────────────────────────────
LOG_LEVEL=INFO
LOG_COLOR=auto
# LOG_FILE_AGENT=logs/executor.log
# LOG_FILE_WORKFLOW=logs/workflow.log

# Painel ao vivo no terminal (estatisticas em tempo real no lugar do log
# passo-a-passo). Com ele ativo o log completo vai para arquivo rotativo.
#   auto (default) — liga se o terminal for interativo e o `rich` existir
#   on             — forca, mesmo sem terminal interativo
#   off            — nunca; mantem o log linha a linha no console
# EXECUTOR_DASHBOARD=auto
# Segundos entre atualizacoes do painel (minimo 0.25). Default 1.0.
# EXECUTOR_DASHBOARD_INTERVAL=1.0
# Onde o painel grava os logs. Default: <pai de EXECUTOR_ARTIFACTS_DIR>/logs
# (no host, ~/AtlansExecutor/logs). LOG_FILE_AGENT/LOG_FILE_WORKFLOW tem precedencia.
# EXECUTOR_LOG_DIR=

# ── Reescrita de hostnames (executor fora do Docker) ─
# Quando o executor roda externamente mas recebe connection strings
# apontando para hostnames internos do compose (ex: db, redis), reescreve
# em runtime. Formato: "db=localhost:5433,redis=localhost:6379"
# EXECUTOR_HOST_ALIASES=

# ── GeoSync (opcional) ───────────────────────────
# Vazio = desabilitado. No Docker, o path e /data/sync (montado via volume —
# veja docker-compose.executor.yml). Rodando direto no host, use o caminho local.
EXECUTOR_SYNC_DIRS=
# Modo e intervalo diferem DE PROPOSITO do padrao do executor (upload e 30s,
# que so valem quando a linha falta): a instalacao nova comeca sincronizando nos
# dois sentidos, com varredura a cada 10s — o intervalo que o app desktop grava.
# `upload` e o padrao seguro: nada que aconteca no Drive apaga ou sobrescreve
# arquivo local.
EXECUTOR_SYNC_MODE=bidirectional
EXECUTOR_SYNC_INTERVAL=10
EXECUTOR_SYNC_CONFLICT_STRATEGY=remote-wins
# Dispara workflows ao detectar arquivos. Exemplo (preencha workflow_id_hash real):
# EXECUTOR_SYNC_TRIGGERS=[{"pattern": "*.geojson", "workflow_id_hash": "<wf_hash>", "inputs": {"file": "{{original_name}}"}}]
EXECUTOR_SYNC_TRIGGERS=

# ── MinIO/S3 ─────────────────────────────────────
# Lida so pelo no SendEmail (flow/nodes/outputs/send_email.py), para montar o
# link do anexo quando a URL pre-assinada nao sai. O endereco publico do S3 da
# sua instalacao (ex.: https://s3.seu-dominio); vazio, o e-mail sai sem o link
# nesse caso (com um aviso no log do no).
MINIO_EXTERNAL_ENDPOINT=

# ── Servicos de terceiros ─────────────────────────
# No Geocode: um Nominatim proprio. Vazio = o publico
# (nominatim.openstreetmap.org), que aceita 1 pedido por segundo. O
# User-Agent leva o site desta instalacao (o EXECUTOR_SERVER_URL acima); um
# endereco interno (IP privado, localhost, nome sem dominio) fica de fora.
#NOMINATIM_URL=https://nominatim.seu-dominio

# Workspace fixo para GeoSync (opcional — se nao definido, auto-detecta).
EXECUTOR_WORKSPACE_ID=

# ── Renewal automatico do cert (defaults) ────────
# EXECUTOR_CERT_RENEW_BEFORE_DAYS=7
# EXECUTOR_CERT_RENEW_CHECK_SECONDS=3600

# ── Nos que rodam aqui (flow/) ────────────────────
# Por quanto tempo o no WFS reaproveita o GetCapabilities de um mesmo endpoint
# entre execucoes e retries (segundos; 0 desliga o cache).
# WFS_CAPABILITIES_TTL_S=3600
# Acima deste tamanho (bytes), o body do ResponseNode sobe ao MinIO como
# artefato em vez de trafegar pelo WebSocket executor->servidor.
# WEBHOOK_RESPONSE_INLINE_LIMIT=1048576
