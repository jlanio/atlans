# ===============================================
#  Atlans — executor configuration
# ===============================================
#
# After enrollment (`python -m executor enroll` — see executor/README.md),
# the executor receives an mTLS cert persisted in EXECUTOR_CERT_DIR. From then
# on, all authentication with the server goes through mTLS — no API key.

# ── Identity ─────────────────────────────────────
# The executor's id_hash, received from the admin when creating the executor
# on the platform.
EXECUTOR_ID=
# Executors host of your installation (end-to-end mTLS), in wss://.
# No default: enroll writes here the --server of the enrollment command.
EXECUTOR_SERVER_URL=

# ── mTLS cert (persisted at enrollment) ──────────
# Directory with cert.pem, chain.pem, ca.pem, key.pem and x25519_key.pem
# (permissions 0o600 on the files, 0o700 on the directory).
EXECUTOR_CERT_DIR=./certs

# ── Server public key (Ed25519) ──────────────────
# Obtained from GET /executores/server-public-key. Empty = auto-fetch at startup.
SERVER_SIGNING_PUBLIC_KEY=

# ── Execution ────────────────────────────────────
# EXECUTOR_VERSION does not go here: the Docker image writes the version at
# build time (executor/versao.py) and the desktop app sets its own.
# The defaults of executor/config.py (ranges in executor/README.md) — the
# desktop app's Ajustes screen marks as "alterado" (changed) whatever differs
# from them.
EXECUTOR_MAX_CONCURRENT=4
EXECUTOR_MAX_QUEUE_SIZE=50
EXECUTOR_JOB_TIMEOUT=3600
# Cap of the exponential backoff between WebSocket reconnection attempts (s).
# EXECUTOR_RECONNECT_MAX_DELAY=15

# Auto-restart when the server sends `config_changed` (e.g. a workspace
# assigned this executor). The executor needs to re-read the configuration at boot.
#   auto (default) — re-executes its own process when there is NO supervisor;
#                    in a container, exits with code 1 and lets Docker restart
#                    it (`restart: on-failure`), which also picks up a new image.
#   always         — always re-executes, even in a container.
#   never          — just exits; use it if an external supervisor (systemd,
#                    pm2, NSSM) already handles the restart.
# Anti-loop guard: at most 5 restarts in 5 minutes.
# EXECUTOR_AUTO_RESTART=auto

# ── Security ─────────────────────────────────────
# TTL of the nonce cache for job anti-replay (s). Default 600.
# NONCE_CACHE_TTL=600

# ── Logs e painel ────────────────────────────────
LOG_LEVEL=INFO
LOG_COLOR=auto
# LOG_FILE_AGENT=logs/executor.log
# LOG_FILE_WORKFLOW=logs/workflow.log

# Live dashboard in the terminal (real-time statistics instead of the
# step-by-step log). With it active, the full log goes to a rotating file.
#   auto (default) — turns on if the terminal is interactive and `rich` exists
#   on             — forces it, even without an interactive terminal
#   off            — never; keeps the line-by-line log on the console
# EXECUTOR_DASHBOARD=auto
# Seconds between dashboard updates (minimum 0.25). Default 1.0.
# EXECUTOR_DASHBOARD_INTERVAL=1.0
# Where the dashboard writes the logs. Default: <parent of EXECUTOR_ARTIFACTS_DIR>/logs
# (on the host, ~/AtlansExecutor/logs). LOG_FILE_AGENT/LOG_FILE_WORKFLOW take precedence.
# EXECUTOR_LOG_DIR=

# ── Hostname rewriting (executor outside Docker) ─
# When the executor runs externally but receives connection strings
# pointing to internal compose hostnames (e.g. db, redis), rewrites them
# at runtime. Format: "db=localhost:5433,redis=localhost:6379"
# EXECUTOR_HOST_ALIASES=

# ── GeoSync (optional) ───────────────────────────
# Empty = disabled. In Docker, the path is /data/sync (mounted via volume —
# see docker-compose.executor.yml). Running directly on the host, use the local path.
EXECUTOR_SYNC_DIRS=
# Mode and interval differ ON PURPOSE from the executor's default (upload and
# 30s, which only apply when the line is missing): a new installation starts
# syncing both ways, scanning every 10s — the interval the desktop app writes.
# `upload` is the safe default: nothing that happens in the Drive deletes or
# overwrites a local file.
EXECUTOR_SYNC_MODE=bidirectional
EXECUTOR_SYNC_INTERVAL=10
EXECUTOR_SYNC_CONFLICT_STRATEGY=remote-wins
# Dispara workflows ao detectar arquivos. Exemplo (preencha workflow_id_hash real):
# EXECUTOR_SYNC_TRIGGERS=[{"pattern": "*.geojson", "workflow_id_hash": "<wf_hash>", "inputs": {"file": "{{original_name}}"}}]
EXECUTOR_SYNC_TRIGGERS=

# ── MinIO/S3 ─────────────────────────────────────
# Read only by the SendEmail node (flow/nodes/outputs/send_email.py), to build
# the attachment link when the presigned URL does not come out. The public S3
# address of your installation (e.g. https://s3.seu-dominio); if empty, the
# email goes out without the link in that case (with a warning in the node log).
MINIO_EXTERNAL_ENDPOINT=

# ── Third-party services ──────────────────────────
# In Geocode: a self-hosted Nominatim. Empty = the public one
# (nominatim.openstreetmap.org), which accepts 1 request per second. The
# User-Agent carries this installation's site (the EXECUTOR_SERVER_URL above);
# an internal address (private IP, localhost, name without a domain) is left out.
#NOMINATIM_URL=https://nominatim.seu-dominio

# Fixed workspace for GeoSync (optional — if not set, auto-detects).
EXECUTOR_WORKSPACE_ID=

# ── Renewal automatico do cert (defaults) ────────
# EXECUTOR_CERT_RENEW_BEFORE_DAYS=7
# EXECUTOR_CERT_RENEW_CHECK_SECONDS=3600

# ── Nodes that run here (flow/) ───────────────────
# How long the WFS node reuses the GetCapabilities of the same endpoint
# across runs and retries (seconds; 0 disables the cache).
# WFS_CAPABILITIES_TTL_S=3600
# Above this size (bytes), the ResponseNode body is uploaded to MinIO as an
# artifact instead of traveling over the executor->server WebSocket.
# WEBHOOK_RESPONSE_INLINE_LIMIT=1048576
